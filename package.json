    "@sveltejs/vite-plugin-svelte-inspector": "^2.1.0",
    "@tailwindcss/forms": "^0.5.9",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "estree-walker": "^3.0.3",
    "laravel-vite-plugin": "^1.0.5",
    "postcss": "^8.4.47",
    "rollup-plugin-concat": "^1.0.3",
    "sass": "^1.78.0",
    "svelte-check": "^3.8.6",
    "svelte-preprocess": "^5.1.4",
    "tailwindcss": "^3.4.11",
